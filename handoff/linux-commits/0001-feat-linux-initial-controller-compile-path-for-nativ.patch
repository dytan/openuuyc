+        use windows::Win32::UI::Input::KeyboardAndMouse::{GetAsyncKeyState, GetKeyState};
+        if unsafe { (GetKeyState(144) & 1 != 0) ^ (GetAsyncKeyState(16) < 0) } {
+            return Some(vk);
+        }
+    }
