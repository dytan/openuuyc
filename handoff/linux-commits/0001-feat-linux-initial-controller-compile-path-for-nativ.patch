+    match result {
+        Ok(bytes) => {
+            if bytes == cache.bytes && cache.error.is_none() {
+                return;
+            }
+            let parsed = bytes.as_ref().map_or_else(
+                || Ok(Settings::default()),
+                |b| serde_json::from_slice::<Settings>(b).context("快捷键配置无效"),
