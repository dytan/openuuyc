-                    if let Some(v) = v.borrow_mut().as_mut() {
-                        v.sessions.insert(s.id, Arc::downgrade(&s));
-                    }
-                });
-            }
-        }
-        Command::Remove(id) => {
-            let clear = STATE.with(|v| {
-                let mut v = v.borrow_mut();
