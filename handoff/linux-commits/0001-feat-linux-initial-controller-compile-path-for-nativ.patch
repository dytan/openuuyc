+impl Settings {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(self.schema == 1, "快捷键配置格式不支持");
+        for binding in &self.bindings {
+            if let Some(b) = binding {
+                ensure!(
+                    (8..=254).contains(&b.key)
+                        && !matches!(b.key, 16..=18 | 91..=92 | 160..=165 | 229 | 231)
+                        && b.modifiers <= 15,
