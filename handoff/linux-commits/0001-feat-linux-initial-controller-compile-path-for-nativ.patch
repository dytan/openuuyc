-                    epoch,
-                    Envelope {
-                        request: None,
-                        response: Some(Response {
-                            header: Some(Header { id }),
-                            clip: None,
-                            text: Some(ClipboardTextChangeResponse {
-                                err: if result.is_ok() { 1 } else { 2 },
-                            }),
-                        }),
-                    },
-                );
-            }
-        }
-        Command::Request(weak, epoch, id, kind) => {
-            if let Some(s) = weak.upgrade().filter(|s| s.valid(epoch)) {
