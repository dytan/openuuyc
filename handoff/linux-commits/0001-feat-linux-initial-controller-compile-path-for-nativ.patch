+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Action {
+    ReleaseMouse,
+    Fullscreen,
+    Close,
+    Performance,
+}
+impl Action {
+    pub const ALL: [Self; 4] = [
+        Self::ReleaseMouse,
+        Self::Fullscreen,
+        Self::Close,
+        Self::Performance,
+    ];
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::ReleaseMouse => "退出键鼠控制",
+            Self::Fullscreen => "切换全屏",
