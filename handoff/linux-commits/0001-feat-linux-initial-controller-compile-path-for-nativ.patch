+pub(crate) fn modifiers(m: winit::keyboard::ModifiersState) -> u8 {
+    u8::from(m.control_key())
+        | (u8::from(m.shift_key()) << 1)
+        | (u8::from(m.alt_key()) << 2)
+        | (u8::from(m.super_key()) << 3)
