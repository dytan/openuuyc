+fn save(expected: &Option<Vec<u8>>, settings: &Settings) -> Result<()> {
+    settings.validate()?;
+    let handle = unsafe {
+        CreateMutexW(
+            None,
+            false,
+            windows::core::w!("Local\\OpenUUYC.Shortcuts.Settings"),
+        )
+    }?;
